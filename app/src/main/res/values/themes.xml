<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TechCare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackgroundFloating">@color/surface_card</item>
        <item name="android:colorBackground">@color/surface_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="materialButtonStyle">@style/TechCare.PrimaryButton</item>
        <item name="radioButtonStyle">@style/TechCare.RadioButton</item>
        <item name="textInputStyle">@style/TechCare.TextField</item>
        <item name="android:spinnerStyle">@style/TechCare.Spinner</item>
        <item name="android:spinnerItemStyle">@style/TechCare.SpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/TechCare.SpinnerDropDownItem</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>
</resources>
